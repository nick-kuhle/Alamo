<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Classic (pre-v1) Kodi settings format. Fully supported in Omega/Piers and far
  more forgiving than the newer <settings version="1"> schema. Labels are plain
  English on purpose: nothing here depends on strings.po loading correctly.
-->
<settings>
    <category label="General">
        <setting id="tmdb.sep" type="lsep" label="Metadata (TMDB)" />
        <setting id="tmdb_key" type="text" label="TMDB API key" default="" />
        <setting id="tmdb_key_action" type="action" label="Enter / test TMDB API key..." option="close" action="RunPlugin(plugin://plugin.video.alamo/?action=set_tmdb)" />
        <setting id="tmdb_key_help" type="text" label="Free at themoviedb.org - Settings, API, v3 auth" enable="false" default="" />
        <setting id="tmdb_language" type="select" label="Metadata language" default="en-US" values="en-US|en-GB|es-ES|es-MX|fr-FR|de-DE|it-IT|pt-BR|nl-NL" />

        <setting id="play.sep" type="lsep" label="Playback" />
        <setting id="autoplay" type="bool" label="Autoplay best stream" default="true" />
        <setting id="max_quality" type="select" label="Maximum quality" default="1080p" values="4K|1080p|720p|SD" />
        <setting id="allow_cam" type="bool" label="Allow CAM / TS releases" default="false" />
        <setting id="scrape_timeout" type="slider" label="Provider timeout (seconds)" default="45" range="10,5,120" option="int" />
    </category>

    <category label="Providers">
        <setting id="playlist.sep" type="lsep" label="Built-in playlist provider (Sports)" />
        <setting id="playlist_url" type="text" label="Playlist URL or file (M3U or Alamo JSON)" default="" />
        <setting id="playlist_refresh" type="slider" label="Refresh playlist every (minutes)" default="30" range="5,5,240" option="int" />

        <setting id="scrapers.sep" type="lsep" label="Scrapers" />
        <setting id="provider_archive" type="bool" label="Internet Archive (public domain films)" default="true" />
        <setting id="require_resolvable" type="bool" label="Hide links ResolveURL cannot play" default="true" />
        <setting id="max_sources" type="slider" label="Stop after this many sources" default="60" range="10,10,200" option="int" />
        <setting id="open_sites_folder" type="action" label="Where do site configs go?" option="close" action="RunPlugin(plugin://plugin.video.alamo/?action=sites_folder)" />

        <setting id="providers.sep" type="lsep" label="Installed providers" />
        <setting id="show_providers" type="action" label="Show installed providers" option="close" action="RunPlugin(plugin://plugin.video.alamo/?action=providers)" />
        <setting id="tmdb_prompted" type="bool" label="First-run prompt shown" default="false" visible="false" />
        <setting id="disabled_providers" type="text" label="Disabled provider ids (JSON list)" default="[]" visible="false" />
    </category>

    <category label="Maintenance">
        <setting id="maint.sep" type="lsep" label="Maintenance" />
        <setting id="clear_cache" type="action" label="Clear cache" option="close" action="RunPlugin(plugin://plugin.video.alamo/?action=clear_cache)" />
        <setting id="clear_progress" type="action" label="Clear Continue Watching" option="close" action="RunPlugin(plugin://plugin.video.alamo/?action=clear_progress)" />
    </category>
</settings>
