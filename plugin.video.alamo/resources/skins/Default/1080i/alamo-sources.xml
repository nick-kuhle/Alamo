<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="true">50</defaultcontrol>
  <controls>
      <control type="image">
        <left>0</left><top>0</top>
        <width>1920</width><height>1080</height>
        <texture>white.png</texture>
        <aspectratio>scale</aspectratio>
        <colordiffuse>CC000000</colordiffuse>
        
      </control>
      <control type="image">
        <left>460</left><top>200</top>
        <width>1000</width><height>680</height>
        <texture>white.png</texture>
        <aspectratio>scale</aspectratio>
        <colordiffuse>FA0D0D14</colordiffuse>
        
      </control>
      <control type="image">
        <left>460</left><top>200</top>
        <width>1000</width><height>4</height>
        <texture>white.png</texture>
        <aspectratio>scale</aspectratio>
        <colordiffuse>FFE8B44A</colordiffuse>
        
      </control>
      <control type="label">
        <left>500</left><top>226</top>
        <width>920</width><height>50</height>
        <label>$INFO[Window.Property(Title)]</label>
        <font>font20</font>
        <textcolor>FFF4F4F6</textcolor>
        <align>left</align><aligny>center</aligny>
        
      </control>
      <control type="label">
        <left>500</left><top>280</top>
        <width>920</width><height>34</height>
        <label>$INFO[Window.Property(Status)]</label>
        <font>font12</font>
        <textcolor>FFE8B44A</textcolor>
        <align>left</align><aligny>center</aligny>
        
      </control>
      <control type="image">
        <left>500</left><top>322</top>
        <width>920</width><height>3</height>
        <texture>white.png</texture>
        <aspectratio>scale</aspectratio>
        <colordiffuse>22FFFFFF</colordiffuse>
        
      </control>
    <control type="group">
      <visible>!String.IsEmpty(Window.Property(Scanning))</visible>
      <control type="image">
        <left>940</left><top>520</top>
        <width>48</width><height>48</height>
        <texture>spinner.png</texture>
        <aspectratio>keep</aspectratio>
        <colordiffuse>FFE8B44A</colordiffuse>
        <animation effect="rotate" end="360" center="auto" time="900" loop="true" condition="true">Conditional</animation>
      </control>
    </control>
    <control type="list" id="50">
      <left>500</left><top>350</top>
      <width>920</width><height>500</height>
      <scrolltime tween="sine">200</scrolltime>
      <itemlayout width="920" height="62">
        <control type="label">
          <left>0</left><top>0</top><width>90</width><height>62</height>
          <label>$INFO[ListItem.Property(quality)]</label>
          <font>font12</font><textcolor>FFE8B44A</textcolor><aligny>center</aligny>
        </control>
        <control type="label">
          <left>100</left><top>0</top><width>600</width><height>62</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font12</font><textcolor>FFF4F4F6</textcolor><aligny>center</aligny>
        </control>
        <control type="label">
          <left>710</left><top>0</top><width>210</width><height>62</height>
          <label>$INFO[ListItem.Property(size)]  $INFO[ListItem.Property(provider)]</label>
          <font>font10</font><textcolor>FF9A9AA6</textcolor>
          <align>right</align><aligny>center</aligny>
        </control>
      </itemlayout>
      <focusedlayout width="920" height="62">
        <control type="image">
          <left>-10</left><top>2</top><width>940</width><height>58</height>
          <texture border="8">white.png</texture><colordiffuse>22FFFFFF</colordiffuse>
        </control>
        <control type="image">
          <left>-10</left><top>2</top><width>4</width><height>58</height>
          <texture>white.png</texture><colordiffuse>FFE8B44A</colordiffuse>
        </control>
        <control type="label">
          <left>0</left><top>0</top><width>90</width><height>62</height>
          <label>$INFO[ListItem.Property(quality)]</label>
          <font>font12</font><textcolor>FFE8B44A</textcolor><aligny>center</aligny>
        </control>
        <control type="label">
          <left>100</left><top>0</top><width>600</width><height>62</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font12</font><textcolor>FFF4F4F6</textcolor><aligny>center</aligny>
        </control>
        <control type="label">
          <left>710</left><top>0</top><width>210</width><height>62</height>
          <label>$INFO[ListItem.Property(size)]  $INFO[ListItem.Property(provider)]</label>
          <font>font10</font><textcolor>FF9A9AA6</textcolor>
          <align>right</align><aligny>center</aligny>
        </control>
      </focusedlayout>
    </control>
      <control type="label">
        <left>500</left><top>560</top>
        <width>920</width><height>40</height>
        <label>Nothing found - try another provider</label>
        <font>font13</font>
        <textcolor>FF9A9AA6</textcolor>
        <align>center</align><aligny>center</aligny>
        <visible>!String.IsEmpty(Window.Property(Empty))</visible>
      </control>
  </controls>
</window>
